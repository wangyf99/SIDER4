    molecule = chembl.molecule.filter(chembl_id=chembl_id) #.only(['drugbank_id'])

    # Extract DrugBank ID if available
    print(molecule)
    drugbank_id = molecule[0]['drugbank_id'] if molecule else None

    return drugbank_id

