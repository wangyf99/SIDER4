def pubchem_id_to_drug_name_unichem(uci):
    url = "https://www.ebi.ac.uk/unichem/api/v1/compounds"
    data = {
        "compound": uci,
        "sourceID": 22,
        "type": "sourceID"
    }
    
    response = requests.post(url, json=data)
    if response.status_code == 200:
        try:
            content = response.json()['compounds'][0]['sources']
        except:
            print(uci)
        for i in content:
            if i['id'] == 45:
                name = [i['compoundId']]
                return name[0]
        return None
    else:
        return None



